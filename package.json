{
  "name": "virtuocity",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @virtuocity/app",
    "build": "npm run build -w @virtuocity/app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "duplication": "jscpd packages",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run duplication && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
